<UserControl x:Class="ReservePane.Ui.Controls.StatusWindowHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ReservePane.Ui.Controls"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Foreground="#EAF0F6"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#EAF0F6" />
            <Setter Property="Background" Value="#232D37" />
            <Setter Property="BorderBrush" Value="#566472" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#354453" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B6DBFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#445A6E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAB7C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6,0,0,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="ReservePane" />
            <TextBlock Margin="6,1,8,0" FontSize="11" Foreground="#AAB7C4"
                       Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType={x:Type controls:StatusWindowHeader}}}" />
        </StackPanel>
        <Button Grid.Column="1"
                Width="94"
                Click="OnRefreshClicked"
                AutomationProperties.Name="Refresh now"
                ToolTip="Refresh all providers now">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HeaderButton}">
                    <Setter Property="Content" Value="Refresh" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRefreshing, RelativeSource={RelativeSource AncestorType={x:Type controls:StatusWindowHeader}}}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Content" Value="Refreshing..." />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Button Grid.Column="2"
                Width="28"
                Margin="6,0,0,0"
                Padding="0"
                Style="{StaticResource HeaderButton}"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                Content="&#xE711;"
                Click="OnCloseClicked"
                AutomationProperties.Name="Close to tray"
                ToolTip="Close to tray" />
    </Grid>
</UserControl>
